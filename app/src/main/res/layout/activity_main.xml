<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- ===== TOP BAR ===== -->
    <ImageButton
        android:id="@+id/btn_menu"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_menu"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Menu"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="20dp" />

    <TextView
        android:id="@+id/tv_toolbar_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calculator"
        android:textColor="@color/text_white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        app:layout_constraintTop_toTopOf="@id/btn_menu"
        app:layout_constraintBottom_toBottomOf="@id/btn_menu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btn_settings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_settings"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Settings"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp" />

    <!-- ===== DISPLAY AREA ===== -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_display"
        android:layout_width="0dp"
        android:layout_height="120dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/btn_menu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Expression (e.g., "12 + 8") -->
            <TextView
                android:id="@+id/tv_expression"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:gravity="end"
                android:fontFamily="sans-serif"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Result (e.g., "20") -->
            <TextView
                android:id="@+id/tv_result"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/text_white"
                android:textSize="48sp"
                android:textStyle="bold"
                android:gravity="end"
                android:fontFamily="sans-serif"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- ===== BUTTON GRID ===== -->
    <GridLayout
        android:id="@+id/grid_buttons"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:columnCount="4"
        android:rowCount="5"
        android:useDefaultMargins="false"
        app:layout_constraintTop_toBottomOf="@id/card_display"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="30dp">

        <!-- Row 1: C  +/-  %  ÷ -->
        <Button
            android:id="@+id/btn_clear"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="C"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:backgroundTint="@color/btn_secondary"
            android:layout_margin="6dp"
            style="@style/CalcButton" />

        <Button
            android:id="@+id/btn_sign"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="+/-"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:backgroundTint="@color/btn_secondary"
            android:layout_margin="6dp"
            style="@style/CalcButton" />

        <Button
            android:id="@+id/btn_percent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="%"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:backgroundTint="@color/btn_secondary"
            android:layout_margin="6dp"
            style="@style/CalcButton" />

        <Button
            android:id="@+id/btn_divide"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="÷"
            android:textColor="@color/text_white"
            android:textSize="24sp"
            android:backgroundTint="@color/accent_purple"
            android:layout_margin="6dp"
            style="@style/CalcButton" />

        <!-- Row 2: 7  8  9  × -->
        <Button
            android:id="@+id/btn_7"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="7"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:backgroundTint="@color/btn_primary"
            android:layout_margin="6dp"
            style="@style/CalcButton" />

        <Button
            android:id="@+id/btn_8"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="8"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:backgroundTint="@color/btn_primary"
            android:layout_margin="6dp"
            style="@style/CalcButton" />

        <Button
            android:id="@+id/btn_9"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="9"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:backgroundTint="@color/btn_primary"
            android:layout_margin="6dp"
            style="@style/CalcButton" />

        <Button
            android:id="@+id/btn_multiply"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="×"
            android:textColor="@color/text_white"
            android:textSize="24sp"
            android:backgroundTint="@color/accent_purple"
            android:layout_margin="6dp"
            style="@style/CalcButton" />

        <!-- Row 3: 4  5  6  − -->
        <Button
            android:id="@+id/btn_4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="4"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:backgroundTint="@color/btn_primary"
            android:layout_margin="6dp"
            style="@style/CalcButton" />

        <Button
            android:id="@+id/btn_5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="5"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:backgroundTint="@color/btn_primary"
            android:layout_margin="6dp"
            style="@style/CalcButton" />

        <Button
            android:id="@+id/btn_6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="6"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:backgroundTint="@color/btn_primary"
            android:layout_margin="6dp"
            style="@style/CalcButton" />

        <Button
            android:id="@+id/btn_subtract"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="−"
            android:textColor="@color/text_white"
            android:textSize="24sp"
            android:backgroundTint="@color/accent_purple"
            android:layout_margin="6dp"
            style="@style/CalcButton" />

        <!-- Row 4: 1  2  3  + -->
        <Button
            android:id="@+id/btn_1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="1"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:backgroundTint="@color/btn_primary"
            android:layout_margin="6dp"
            style="@style/CalcButton" />

        <Button
            android:id="@+id/btn_2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="2"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:backgroundTint="@color/btn_primary"
            android:layout_margin="6dp"
            style="@style/CalcButton" />

        <Button
            android:id="@+id/btn_3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="3"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:backgroundTint="@color/btn_primary"
            android:layout_margin="6dp"
            style="@style/CalcButton" />

        <Button
            android:id="@+id/btn_add"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="+"
            android:textColor="@color/text_white"
            android:textSize="24sp"
            android:backgroundTint="@color/accent_purple"
            android:layout_margin="6dp"
            style="@style/CalcButton" />

        <!-- Row 5: 0 (spans 2)  .  = -->
        <Button
            android:id="@+id/btn_0"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="2"
            android:layout_rowWeight="1"
            android:text="0"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:backgroundTint="@color/btn_primary"
            android:gravity="center"
            android:layout_margin="6dp"
            style="@style/CalcButton" />

        <Button
            android:id="@+id/btn_dot"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="."
            android:textColor="@color/text_white"
            android:textSize="28sp"
            android:backgroundTint="@color/btn_primary"
            android:layout_margin="6dp"
            style="@style/CalcButton" />

        <Button
            android:id="@+id/btn_equals"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:text="="
            android:textColor="@color/text_white"
            android:textSize="28sp"
            android:backgroundTint="@color/accent_purple"
            android:layout_margin="6dp"
            style="@style/CalcButton" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>